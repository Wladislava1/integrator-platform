@startuml activity-entry
!pragma layout smetana
skinparam defaultFontName Segoe UI
skinparam dpi 140
title Вход в Связь ID и ответ продукту

start
:Физическое лицо открывает платформу;
if (Учётная запись уже есть?) then (нет)
  :Регистрация:\nФИО, email, пароль;
else (да)
endif
:Вход по email и паролю;
:Сессия создана и сразу активна;
:Каталог с карточкой\nтестового продукта;
:Тестовый продукт запрашивает, кто вошёл;
if (Токен сессии действует?) then (да)
  :Ответ 200: id, имя, email.\nТестовый продукт показывает\nимя и email;
else (нет)
  :Ответ 401 «Требуется вход».\nИмя не показывается,\nсвою учётную запись продукт не создаёт;
endif
stop
@enduml
