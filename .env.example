# Порт локального запуска (информативно)
PORT=3000

# Локальная PostgreSQL (docker run --name svyaz-postgres -p 5432:5432)
DATABASE_URL=postgres://svyaz:svyaz@localhost:5432/svyaz

# Продукт «Потеряшки»
LOST_PETS_API_URL=http://127.0.0.1:8000
